# Backend configuration. Copy to .env (never commit it) or export these variables.
# Database
DB_URL=jdbc:mysql://localhost:3306/marram?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=marram
DB_PASSWORD=change-me

# Supabase: the project URL only. Issuer and JWKS URL are derived from it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# OPTIONAL. Only for legacy projects that still sign with the HS256 shared secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Create profiles only for emails Supabase reports as verified. Keep true.
SUPABASE_REQUIRE_VERIFIED_EMAIL=true

# Browser origin allowed to call the API (exact match, no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
# IANA zone used for "today" in overdue and upcoming calculations
APP_TIME_ZONE=UTC
