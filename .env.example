# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.

# --- Database (choose strong values; MySQL is not published outside the compose network) ---
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public, browser-safe key (starts with sb_publishable_). NOT the secret key or service_role key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_JWT_AUDIENCE=authenticated
# OPTIONAL: legacy HS256 projects only
SUPABASE_JWT_SECRET=
# Only create profiles for emails Supabase has verified (keep true; turn on "Confirm email" in Supabase Auth)
SUPABASE_REQUIRE_VERIFIED_EMAIL=true

# --- App ---
# Must equal the exact URL users open in the browser (scheme + host + port, no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000
WEB_PORT=3000
APP_TIME_ZONE=UTC
